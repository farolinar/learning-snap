# Base URL of the SNAP server the client talks to (our mock by default).
SNAP_BASE_URL=http://localhost:8080

# Address the mock server listens on.
SNAP_LISTEN_ADDR=:8080

# Partner credentials (these are dummy values from the SNAP spec samples).
SNAP_CLIENT_ID=962489e9-de5d-4eb7-92a4-b07d44d64bf4
SNAP_CLIENT_SECRET=xS3vNQQgJRemFF0SZfXkZOq3r7kQ9n5YJgK4Wg0tVCQ=
SNAP_PARTNER_ID=82150823919040624621823174737537
SNAP_CHANNEL_ID=95221

# Key paths (relative to where the command runs).
SNAP_PRIVATE_KEY=keys/private.pem
SNAP_PUBLIC_KEY=keys/public.pem

# Secret used to sign our JWT access tokens, and their TTL (B2B = 900s per spec).
SNAP_JWT_SECRET=snap-lab-jwt-secret
SNAP_TOKEN_TTL_SECONDS=900